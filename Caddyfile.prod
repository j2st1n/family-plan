# Caddyfile for Family Plan
# 复制到 /etc/caddy/Caddyfile 并替换域名后 systemctl reload caddy

kids.example.com {
    encode gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * /home/j2/projects/family-plan/src/child-pwa/dist
        try_files {path} /index.html
        file_server
    }
}

mom.example.com {
    encode gzip

    handle /api/* {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        root * /home/j2/projects/family-plan/src/parent-web/dist
        try_files {path} /index.html
        file_server
    }
}
